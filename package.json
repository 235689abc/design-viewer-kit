{
  "name": "design-viewer-kit",
  "version": "0.1.0",
  "description": "A generic, read-only flow and data design inventory viewer.",
  "private": false,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/schema"
  ],
  "scripts": {
    "dev": "npm --workspace @design-viewer/web run dev",
    "build": "npm --workspace @design-viewer/web run build",
    "preview": "npm --workspace @design-viewer/web run preview",
    "generate": "python3 tools/gen_diagrams.py --config design-viewer.config.json",
    "validate": "python3 tools/validate_manifest.py --spec docs/diagrams/flows.json",
    "scaffold": "python3 tools/scaffold_flow.py --root ."
  },
  "engines": {
    "node": ">=18",
    "python": ">=3.10"
  },
  "license": "MIT"
}
